{
  "name": "@pearl-ledger/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx ../../node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node --import tsx ../../node_modules/vite/bin/vite.js build",
    "preview": "node --import tsx ../../node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "bridge": "node --import tsx src/bridge-main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "web": "node --import tsx src/web-server.ts",
    "local": "node --import tsx src/local-main.ts"
  },
  "dependencies": {
    "@ledgerhq/device-management-kit": "1.11.0",
    "@ledgerhq/device-transport-kit-web-hid": "1.2.4",
    "@ledgerhq/lumen-design-core": "0.1.33",
    "@ledgerhq/lumen-ui-react": "0.1.65",
    "@ledgerhq/wallet-api-client": "1.16.0",
    "@pearl-ledger/bitcoin-prl-adapter": "0.1.0",
    "@pearl-ledger/sdk": "0.1.0",
    "@pearl-ledger/wallet": "0.1.0",
    "buffer": "6.0.3",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}
