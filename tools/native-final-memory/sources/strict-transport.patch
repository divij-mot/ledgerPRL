+/* Pearl: bind the Ledger-standard checked BIP32 wrapper. Catch exceptions in C
+ * so no longjmp crosses Rust secret guards. The newer sys_hdkey_derive syscall
+ * does not implement ordinary BIP32 in the pinned Speculos. No seed/curve
+ * selector is exposed, and there is no fallback or root derivation route. */
+#include "libcxng.h"
+#include "os_seed.h"
+cx_err_t pearl_derive_bip32_no_throw(const uint32_t *path,
+                                   size_t path_len,
+                                   uint8_t raw_private[static 64],
+                                   uint8_t chain_code[static 32]) {
+    if (path == NULL || (path_len != 3 && path_len != 5)) {
+        return CX_INVALID_PARAMETER;
+    }
+    return os_derive_bip32_no_throw(CX_CURVE_SECP256K1, path,
+                                     (unsigned int) path_len, raw_private, chain_code);
+}
+
+/* Fixed-length SDK zero predicate: constant-time and no exception path. */
+bool pearl_scalar_is_zero(const uint8_t scalar[static 32]) {
+    return cx_math_is_zero(scalar, 32);
+}
