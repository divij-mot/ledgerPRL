+// Pearl-only: called synchronously by the borrowed Comm's NBGL callback.
+// No pointers into application state and no outstanding Comm alias are used.
+#[cfg(feature = "io_new")]
+pub(crate) fn abort_review() {
+    unsafe {
+        G_RET = SyncNbgl::UxSyncRetRejected.into();
+        G_ENDED = true;
+    }
+}
+
